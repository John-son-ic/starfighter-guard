    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
