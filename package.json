{
  "name": "starfighter-guard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "models:export": "node scripts/export-models.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
